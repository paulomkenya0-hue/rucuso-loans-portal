# Copy this file to .env and fill in your Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# IMPORTANT:
# - Only the "anon public" key goes here. NEVER put the "service_role" key
#   in this file or anywhere in frontend code — it bypasses Row Level Security.
# - This .env file must NOT be committed to git or uploaded to your host's
#   public files. Set these same two values as Environment Variables in your
#   Vercel/Netlify project settings for the deployed site.
